<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CPEN322 Project</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://ubc-cpen-322.github.io/obfuscated/test-a1.js" type="text/javascript"></script>
  </head>
  <body>
    <div id="app-view">
      <ul id="app-menu">
        <li class="menu-item"><a href="/">Rooms</a></li>
        <li class="menu-item"><a href="/profile">Profile</a></li>
      </ul>

      <div id="page-view">
        <div class="content">
            <div class="profile-form">
                <div class="form-field">
                  <label>Label</label>
                  <input type="text" />
                </div>
          
                <div class="form-field">
                  <label>Label</label>
                  <input type="password" />
                </div>
          
                <div class="form-field">
                  <label>Label</label>
                  <input type="file" />
                </div>
            </div>

            <div class="page-control">
                <button>Save</button>
            </div>
        </div>
      </div>
    </div>
  </body>
</html>