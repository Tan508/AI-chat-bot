<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>CPEN322 Project</title>
    <link rel="stylesheet" href="style.css">
    <script src="https://ubc-cpen-322.github.io/obfuscated/test-a1.js" type="text/javascript"></script>
  </head>
  <body>
    <div id="app-view">
      <ul id="app-menu">
        <li class="menu-item"><a href="/">Rooms</a></li>
        <li class="menu-item"><a href="/profile">Profile</a></li>
      </ul>
      
      <div id="page-view">
        <div class="content">
          <h4 class="room-name"></h4>
          
          <div class="message-list">
            <div class="message">
              <span class="message-user"></span>
              <span class="message-text"></span>
            </div>
            
            <div class="message my-message">
              <span class="message-user"></span>
              <span class="message-text"></span>
            </div>
          </div>
          
          <div class="page-control">
            <textarea></textarea>
            <button>Send</button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>